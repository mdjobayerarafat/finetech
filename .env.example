# BankPilot environment
# Copy to .env and adjust as needed.

# --- Database ---
# Absolute path so the API and seed scripts always see the same file.
DATABASE_URL=sqlite:////home/jobayer/Documents/bankpilot/bankpilot.db

# --- Server ---
HOST=0.0.0.0
PORT=8080
# Set to "production" to require Secure cookies. Anything else is dev.
APP_ENV=development
# Long random string; rotate per environment.
SESSION_SECRET=change-me-in-production-please-32bytes
# How long sessions last (seconds). 12h.
SESSION_TTL_SECONDS=43200
# Pending action expiry (seconds). 5 min.
PENDING_ACTION_TTL_SECONDS=300

# --- LLM (OpenAI-compatible) ---
# Leave blank to use the deterministic stub adapter (works offline).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- Policy ---
# Daily transfer threshold in fen. 1,000,000 fen = ¥1,000.00.
DAILY_LIMIT_FEN=1000000
# Mock MFA code (displayed in the UI for the demo).
MFA_DEMO_CODE=000000
# Max failed MFAs before the safety lock triggers.
MAX_FAILED_MFA=3
OPENAI_API_KEY=