# mockbank environment
# Copy to .env and adjust.

# --- Database ---
# Same Postgres the Rust backend uses, but the Go service writes to the
# `mockbank` schema so the two do not collide.
DATABASE_URL=postgres://postgres:Mejobayer2022@20.196.136.237:5432/appdb

# --- Server ---
HOST=0.0.0.0
PORT=8090
APP_ENV=development

# --- Auth ---
# Long random string; must match the Rust backend if you want cross-service JWTs.
SESSION_SECRET=change-me-in-production-please-32bytes
SESSION_TTL_SECONDS=43200

# --- Policy ---
# Daily transfer threshold in fen. 1_000_000 fen = ¥1,000.00.
DAILY_LIMIT_FEN=1000000
# Mock MFA code displayed in the UI for the demo.
MFA_DEMO_CODE=000000
# Max failed MFAs before the safety lock triggers.
MAX_FAILED_MFA=3
